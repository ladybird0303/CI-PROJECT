# Where the app looks for the meter's /api/* endpoints.
#
#  * Local bridge on the laptop (Option B):
#      EXPO_PUBLIC_DEVICE_URL=http://192.168.137.1:3000
#    192.168.137.1 is the address Windows Mobile Hotspot (ICS) gives the laptop.
#    Check yours with `ipconfig` — use the IPv4 of the hotspot adapter.
#
#  * adb reverse (no WiFi, USB only):
#      EXPO_PUBLIC_DEVICE_URL=http://127.0.0.1:3000
#
#  * Meter's own access point (ESP-01 SoftAP, legacy path):
#      EXPO_PUBLIC_DEVICE_URL=http://192.168.4.1
#
# Copy this file to `.env` (git-ignored), restart `npx expo start --clear`.
# You can also change the URL at runtime on the app's Profile tab.
EXPO_PUBLIC_DEVICE_URL=http://192.168.137.1:3000